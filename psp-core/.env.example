# Kopirati u psp-core/.env i upisati prave vrednosti. Fajl .env se NE komituje.
DB_USERNAME=sep
DB_PASSWORD=
# Mora biti ista kao PSP_CORE_CLIENT_SECRET u infra/.env
PSP_CORE_CLIENT_SECRET=
# Zajednicka tajna PSP-a i banke za potpisivanje poruka; ista vrednost mora biti u bank-service/.env
BANK_PSP_HMAC_SECRET=
