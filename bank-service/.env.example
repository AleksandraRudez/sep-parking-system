# Kopirati u bank-service/.env i upisati prave vrednosti. Fajl .env se NE komituje.
DB_USERNAME=sep
DB_PASSWORD=
# Ista vrednost kao BANK_PSP_HMAC_SECRET u psp-core/.env
BANK_PSP_HMAC_SECRET=
# Tajni kljuc banke za HMAC brojeva kartica i CVV-a (ne menjati posle prvog pokretanja, inace test kartice ne rade)
BANK_CARD_HMAC_KEY=
