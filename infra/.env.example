# Kopirati u infra/.env i upisati prave vrednosti. Fajl .env se NE komituje.
DB_USERNAME=sep
DB_PASSWORD=
# Lozinka za Keycloak admin konzolu (korisnik admin)
KEYCLOAK_ADMIN_PASSWORD=
# Pocetna lozinka super admina u realm-u psp (min. 12 znakova, veliko i malo slovo, cifra, specijalni znak)
PSP_SUPERADMIN_PASSWORD=
# Tajna servisnog naloga psp-core; ista vrednost mora biti i u psp-core/.env
PSP_CORE_CLIENT_SECRET=
